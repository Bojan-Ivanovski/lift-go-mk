---
import SiteLayout from '../layouts/SiteLayout.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import ProjectFrame from '../components/ProjectFrame.astro';
import ResponsiveMedia from '../components/ResponsiveMedia.astro';
import content from '../data/site';
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const phone = `tel:${content.business.phoneInternational}`;
---

<SiteLayout active="home">
  <main id="main" class="home-page">
    <section class="hero grid grid-cols-1 min-[960px]:grid-cols-[1fr_1.03fr]">
      <div class="hero-copy">
        <p class="eyebrow">
          <i></i> {content.hero.eyebrow}
        </p>
        <svg class="hero-rise" viewBox="0 0 120 180" fill="none" aria-hidden="true">
          <path d="M12 65 60 17l48 48M60 20v144" />
        </svg>
        <h1>
          {content.hero.title}
          <br />
          <em>{content.hero.accentTitle}</em>
        </h1>
        <p class="hero-intro">{content.hero.description}</p>
        <div class="hero-actions">
          <a class="button button-orange" href={`${base}cena/`}>
            Пресметај цена <span>↗</span>
          </a>
          <a class="text-link" href="#teren">
            Види како работиме <span>↓</span>
          </a>
        </div>
        <div class="hero-loads" aria-label="Што креваме">
          <span>Мебел</span>
          <span>Бела техника</span>
          <span>Материјали</span>
        </div>
      </div>
      <figure class="hero-visual">
        <div class="hero-image media-card-frame">
          <div class="media-image-window">
            <ResponsiveMedia
              src={content.hero.image}
              sizes="(min-width: 1600px) 760px, (min-width: 960px) 48vw, 94vw"
              alt={content.hero.imageAlt}
              width={1254}
              height={1254}
              priority
            />
          </div>
          <ProjectFrame />
        </div>
        <figcaption class="hero-caption">
          <span>ОД УЛИЦА. ДО ВАШИОТ КАТ.</span>
          <svg viewBox="0 0 60 24" fill="none" aria-hidden="true">
            <path d="M1 12h55M46 2l10 10-10 10" />
          </svg>
        </figcaption>
      </figure>
      <a class="scroll-cue" href="#uslugi">
        СКРОЛАЈ <span>↓</span>
      </a>
    </section>
    <section class="services section-pad" id="uslugi">
      <div class="section-top">
        <span class="section-number">01 / УСЛУГИ</span>
        <span class="section-aside">НАДВОРЕШЕН ПРИСТАП · СКОПЈЕ</span>
      </div>
      <div class="section-heading-row">
        <h2>
          ШТО
          <br />
          <em>КРЕВАМЕ?</em>
        </h2>
        <p>Кога лифтот е мал, а скалите тесни — товарот го носиме по надворешниот пат.</p>
      </div>
      <div class="service-list">
        {content.services.map((s, i) => (
          <a class="service-row reveal" href={`${base}uslugi/#usluga-${i + 1}`}>
            <span class="service-num">0{i + 1}</span>
            <span class="service-title">{s.title}</span>
            <span class="service-copy">{s.text}</span>
            <span class="service-arrow">↗</span>
          </a>
        ))}
      </div>
      <div class="section-link-row">
        <a class="underlined-link" href={`${base}uslugi/`}>
          Погледни ги сите услуги <span>↗</span>
        </a>
      </div>
    </section>
    <section class="process section-pad" id="teren">
      <div class="section-top">
        <span class="section-number">02 / ЕДНОСТАВНО</span>
        <span class="section-aside">ОД ПРВА ПОРАКА ДО КРЕНАТ ТОВАР</span>
      </div>
      <div class="section-heading-row">
        <h2>
          ТРИ ЧЕКОРИ.
          <br />
          <em>И ГОТОВО.</em>
        </h2>
      </div>
      <div class="steps-grid">
        {content.steps.map((step, i) => (
          <article class="step reveal">
            <span class="step-number">0{i + 1}</span>
            <div class="step-line"></div>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </article>
        ))}
      </div>
    </section>
    <section class="price-band">
      <div class="price-band-inner">
        <div>
          <span class="section-number">03 / ПОЧНИ ТУКА</span>
          <h2>КОЛКУ ЌЕ ЧИНИ?</h2>
          <p>
            Неколку детали се доволни за почетна проценка. Ќе добиеш индивидуална понуда за твојот
            случај.
          </p>
        </div>
        <a href={`${base}cena/`} class="price-link">
          <span>Пресметај цена</span>
          <b aria-hidden="true">↗</b>
        </a>
      </div>
    </section>
    <section class="showcase section-pad" id="galerija">
      <div class="section-top">
        <span class="section-number">04 / ОД ТЕРЕН</span>
        <span class="section-aside">ВИСТИНСКИ ПРОЕКТИ · ВИСТИНСКИ УСЛОВИ</span>
      </div>
      <div class="showcase-head">
        <div>
          <h2>
            LIFTGOMK
            <br />
            <em>НА ТЕРЕН</em>
          </h2>
          <p>Види како изгледа работата во пракса.</p>
        </div>
        <a class="underlined-link" href={`${base}galerija/`}>
          Види ја галеријата <span>↗</span>
        </a>
      </div>
      <ProjectGrid limit={2} featured={true} />
    </section>
    <section class="final-cta">
      <span class="section-number">LIFTGOMK · СКОПЈЕ</span>
      <h2>
        ИМАШ НЕШТО
        <br />
        <em>ЗА КРЕВАЊЕ?</em>
      </h2>
      <div class="final-actions">
        <a class="button button-orange" href={`${base}cena/`}>
          Пресметај цена <span>↗</span>
        </a>
        <a class="button button-outline" href={phone}>
          Јави се · {content.business.phoneDisplay}
        </a>
      </div>
    </section>
  </main>
</SiteLayout>
