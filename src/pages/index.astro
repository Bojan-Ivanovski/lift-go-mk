---
import '../styles/global.css';
import content from '../content/site.json';

type VideoItem = { title: string; video: string; thumbnail?: string; description?: string };
const { business, seo, hero, services, steps, videoSection, contact } = content;
const videos = content.videos as VideoItem[];
const instagram = business.instagram;
const phoneDisplay = business.phoneDisplay;
const phoneHref = `tel:${business.phoneInternational.replace(/\s/g, '')}`;
const { title, description } = seo;
const basePath = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const canonicalUrl = new URL(basePath, Astro.site);
const assetUrl = (path: string) => /^(?:https?:)?\//.test(path) ? path : `${basePath}${path.replace(/^\.\//, '')}`;
const contactUrl = `${basePath}contact/`;
---
<!doctype html>
<html lang="mk">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#363735" />
    <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="mk_MK" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" href={new URL(`${basePath}favicon.svg`, Astro.site)} type="image/svg+xml" />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org', '@type': 'LocalBusiness', name: 'LiftGoMK',
      description, url: canonicalUrl, telephone: business.phoneInternational, areaServed: { '@type': 'City', name: business.location },
      sameAs: [instagram], serviceType: ['Лифт за мебел', 'Вертикален транспорт', 'Помош при преселба']
    })} />
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-cream focus:px-4 focus:py-3 focus:text-ink">Прескокни до содржината</a>

    <header class="shell relative z-10 flex items-center justify-between gap-4 py-5 sm:py-6">
      <a href={basePath} class="display text-2xl text-cream" aria-label="LiftGoMK почетна">LIFTGO<span class="text-signal">MK</span></a>
      <nav class="hidden items-center gap-8 text-base font-bold text-cream/70 md:flex" aria-label="Главна навигација">
        <a class="transition hover:text-cream" href="#uslugi">Услуги</a>
        <a class="transition hover:text-cream" href="#kako">Како работиме</a>
        <a class="transition hover:text-cream" href="#video">На терен</a>
        <a class="transition hover:text-cream" href={contactUrl}>Контакт</a>
      </nav>
      <a href={phoneHref} class="rounded-full border border-white/35 bg-frost px-5 py-2.5 text-sm font-black text-ink shadow-lg transition hover:bg-cream">{phoneDisplay}</a>
    </header>

    <main id="main">
      <section id="top" class="shell grid items-center gap-10 pb-16 pt-5 lg:grid-cols-2 lg:gap-16 lg:pb-24 lg:pt-12">
        <div>
          <p class="mb-6 inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-2 text-sm font-black uppercase tracking-wider text-mint backdrop-blur"><span class="h-2 w-2 rounded-full bg-signal"></span> {hero.eyebrow}</p>
          <h1 class="display text-[clamp(4.2rem,9vw,8.2rem)] leading-[.84] text-cream">{hero.title}<br/><span class="text-signal">{hero.accentTitle}</span></h1>
          <p class="mt-7 max-w-xl text-xl leading-relaxed text-cream/70">{hero.description}</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a href={phoneHref} class="rounded-xl border border-white/40 bg-frost px-7 py-4 text-center text-lg font-black text-ink shadow-xl transition hover:bg-cream">Повикај {phoneDisplay}</a>
            <a href={instagram} target="_blank" rel="noopener noreferrer" class="rounded-xl border border-white/25 bg-white/5 px-7 py-4 text-center text-lg font-black text-cream backdrop-blur transition hover:bg-white/10">Instagram DM</a>
          </div>
        </div>
        <div class="glass-shadow relative mx-2 rounded-2xl border border-white/35 bg-frost p-2 sm:mx-4 lg:mx-0">
          <img src={assetUrl(hero.image)} alt={hero.imageAlt} width="1024" height="1280" class="h-72 w-full rounded-xl object-cover object-[center_40%] sm:h-[30rem] lg:h-[34rem]" fetchpriority="high" />
          <div class="absolute -bottom-5 -left-3 rounded-xl border border-white/25 bg-ink/90 px-6 py-4 backdrop-blur sm:-left-5"><div class="display text-4xl text-signal">{hero.badgeNumber}</div><div class="text-sm font-black uppercase tracking-wider text-cream/65">{hero.badgeLabel}</div></div>
        </div>
      </section>

      <section id="uslugi" class="frosted scroll-mt-8 border-y border-white/35 py-16 text-ink md:py-24">
        <div class="shell"><div class="mb-10 flex items-end justify-between gap-5"><h2 class="display text-5xl md:text-6xl">Што креваме</h2><p class="hidden text-base font-bold text-ink/55 md:block">до балкон · до прозорец · без скали</p></div>
          <div class="grid gap-5 md:grid-cols-3">{services.map((service, i) => <article class="min-h-60 rounded-2xl border border-ink/10 bg-cream/60 p-7 backdrop-blur"><div class="display text-5xl text-signal">{String(i + 1).padStart(2, '0')}</div><h3 class="mt-5 text-2xl font-black">{service.title}</h3><p class="mt-3 text-lg leading-relaxed text-ink/65">{service.text}</p></article>)}</div>
        </div>
      </section>

      <section id="kako" class="shell scroll-mt-8 py-16 md:py-24"><h2 class="display mb-10 text-5xl md:text-6xl">Како работиме</h2><div class="grid gap-5 md:grid-cols-3">{steps.map((step, i) => <article class="frosted glass-shadow min-h-56 rounded-2xl border border-white/35 p-8 text-ink"><span class="text-sm font-black uppercase tracking-wider text-signal">Чекор {String(i + 1).padStart(2, '0')}</span><h3 class="mt-5 text-2xl font-black">{step.title}</h3><p class="mt-3 text-lg leading-relaxed text-ink/70">{step.text}</p></article>)}</div></section>

      <section id="video" class="frosted scroll-mt-8 border-y border-white/35 py-16 text-ink md:py-24">
        <div class="shell"><div class="flex max-w-3xl flex-col gap-4"><p class="text-sm font-black uppercase tracking-[.18em] text-signal">{videoSection.eyebrow}</p><h2 class="display text-5xl md:text-6xl">{videoSection.title}</h2><p class="text-lg leading-relaxed text-ink/65">{videoSection.description}</p></div>
          {videos.length > 0 ? <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">{videos.map((item, i) => <article class="glass-shadow overflow-hidden rounded-2xl border border-ink/10 bg-cream/55"><button type="button" class="video-open group relative block aspect-video w-full overflow-hidden bg-ink text-left" data-video={assetUrl(item.video)} data-poster={item.thumbnail ? assetUrl(item.thumbnail) : ''} data-title={item.title} aria-label={`Пушти видео: ${item.title}`}>{item.thumbnail ? <img src={assetUrl(item.thumbnail)} alt="" loading="lazy" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" /> : <video src={assetUrl(item.video)} muted preload="metadata" playsinline class="h-full w-full object-cover"></video>}<span class="absolute inset-0 bg-gradient-to-t from-black/55 via-transparent to-transparent"></span><span class="absolute left-1/2 top-1/2 grid h-16 w-16 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full bg-signal text-white shadow-xl transition group-hover:scale-110" aria-hidden="true"><svg viewBox="0 0 24 24" class="ml-1 h-7 w-7" fill="currentColor"><path d="M8 5v14l11-7z" /></svg></span><span class="absolute bottom-4 left-4 text-sm font-black uppercase tracking-wider text-white">Видео {String(i + 1).padStart(2, '0')}</span></button><div class="p-6"><h3 class="text-2xl font-black">{item.title}</h3>{item.description && <p class="mt-2 leading-relaxed text-ink/65">{item.description}</p>}</div></article>)}</div> : <div class="mt-10 rounded-2xl border border-ink/10 bg-cream/45 p-8 text-lg font-bold text-ink/60">Наскоро нови видеа од терен.</div>}
        </div>
      </section>

      <dialog id="video-viewer" class="video-dialog" aria-label="Видео прегледувач"><div class="video-dialog-card"><div class="flex items-center justify-between gap-4 border-b border-white/10 px-5 py-4"><h3 id="video-viewer-title" class="text-xl font-black text-cream"></h3><button id="video-close" type="button" class="grid h-11 w-11 place-items-center rounded-full bg-white/10 text-2xl text-cream transition hover:bg-white/20" aria-label="Затвори видео">×</button></div><video id="video-player" controls playsinline class="max-h-[78vh] w-full bg-black"></video></div></dialog>

      <section id="kontakt" class="shell scroll-mt-8 py-16 md:py-24"><h2 class="display max-w-4xl text-5xl leading-none md:text-7xl">{contact.title} <span class="text-signal">{contact.accentTitle}</span></h2><p class="mt-6 max-w-2xl text-xl leading-relaxed text-cream/70">{contact.description}</p><div class="mt-8 flex flex-col gap-3 sm:flex-row"><a href={phoneHref} class="rounded-xl bg-signal px-7 py-4 text-center text-lg font-black text-white transition hover:brightness-110">Повикај {phoneDisplay}</a><a href={instagram} target="_blank" rel="noopener noreferrer" class="rounded-xl border border-white/25 bg-white/5 px-7 py-4 text-center text-lg font-black backdrop-blur transition hover:bg-white/10">Пиши на Instagram</a></div></section>
    </main>

    <footer class="shell flex flex-col gap-5 border-t border-white/10 py-8 text-base font-bold text-cream/55 md:flex-row md:items-center md:justify-between"><a href={basePath} class="display text-xl text-cream">LIFTGO<span class="text-signal">MK</span></a><span>{business.location} · надворешно кревање</span><div class="flex gap-6"><a class="hover:text-cream" href={contactUrl}>Контакт</a><a class="hover:text-cream" href={phoneHref}>{phoneDisplay}</a><a class="hover:text-cream" href={instagram} target="_blank" rel="noopener noreferrer">Instagram</a></div></footer>
    <script>
      const dialog = document.querySelector<HTMLDialogElement>('#video-viewer');
      const player = document.querySelector<HTMLVideoElement>('#video-player');
      const viewerTitle = document.querySelector<HTMLElement>('#video-viewer-title');
      const closeButton = document.querySelector<HTMLButtonElement>('#video-close');
      const closeViewer = () => { if (!dialog || !player) return; player.pause(); player.removeAttribute('src'); player.removeAttribute('poster'); player.load(); dialog.close(); document.body.classList.remove('viewer-open'); };
      document.querySelectorAll<HTMLButtonElement>('.video-open').forEach((button) => button.addEventListener('click', () => { if (!dialog || !player || !viewerTitle) return; player.src = button.dataset.video ?? ''; if (button.dataset.poster) player.poster = button.dataset.poster; viewerTitle.textContent = button.dataset.title ?? ''; dialog.showModal(); document.body.classList.add('viewer-open'); player.play().catch(() => {}); }));
      closeButton?.addEventListener('click', closeViewer);
      dialog?.addEventListener('click', (event) => { if (event.target === dialog) closeViewer(); });
      dialog?.addEventListener('cancel', (event) => { event.preventDefault(); closeViewer(); });
    </script>
  </body>
</html>
