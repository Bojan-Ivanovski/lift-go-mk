---
import { getImage } from 'astro:assets';
import hero from '../assets/images/hero-apartment.jpg';
import materials from '../assets/images/materials.jpg';
import moving from '../assets/images/moving.jpg';
import { mediaPath, mediaUrl } from '../utils/mediaPath';

interface Props {
  src: string;
  alt: string;
  sizes: string;
  priority?: boolean;
  thumbnail?: boolean;
  width: number;
  height: number;
}
const { src, alt, sizes, priority = false, thumbnail = false, width, height } = Astro.props;
const originals = {
  'hero-apartment.jpg': hero,
  'uploads/thumbnails/liftgo-gradezni-materijali.jpg': materials,
  'uploads/thumbnails/liftgo-preselbi.jpg': moving,
};
const source = originals[mediaPath(src) as keyof typeof originals];
const widths = (thumbnail ? [320, 480, 640, 800, 960] : [320, 480, 640, 800, 1024, 1254]).filter(
  (size) => source && size <= source.width,
);
if (source && thumbnail && source.width < 960 && !widths.includes(source.width)) {
  widths.push(source.width);
}
// Crop only previews to the card's 16:9 ratio. Full-size modal media stays untouched.
const variants = source
  ? await Promise.all(
      widths.map((size) =>
        getImage({
          src: source,
          width: size,
          ...(thumbnail ? { height: Math.round((size * 9) / 16), fit: 'cover' } : {}),
          format: 'webp',
          quality: 75,
        }),
      ),
    )
  : [];
// A JPEG img fallback works even in webviews without modern format support.
// WebP is selected through picture; AVIF is intentionally avoided for early iOS 16.
const jpegVariants = source
  ? await Promise.all(
      widths.map((size) =>
        getImage({
          src: source,
          width: size,
          ...(thumbnail ? { height: Math.round((size * 9) / 16), fit: 'cover' } : {}),
          format: 'jpeg',
          quality: 75,
        }),
      ),
    )
  : [];
---

<picture class="responsive-media">
  {variants.length > 0 && (
    <source
      type="image/webp"
      srcset={variants.map((image, index) => `${image.src} ${widths[index]}w`).join(', ')}
      sizes={sizes}
    />
  )}
  <img
    src={jpegVariants.at(-1)?.src ?? mediaUrl(src)}
    srcset={
      jpegVariants.length
        ? jpegVariants.map((image, index) => `${image.src} ${widths[index]}w`).join(', ')
        : undefined
    }
    sizes={jpegVariants.length ? sizes : undefined}
    data-original-src={mediaUrl(src)}
    alt={alt}
    width={thumbnail ? 1600 : width}
    height={thumbnail ? 900 : height}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : undefined}
    decoding="async"
  />
</picture>

<script>
  document.querySelectorAll<HTMLImageElement>('.responsive-media img').forEach((image) => {
    let retries = 0;
    const recover = () => {
      if (retries >= 2) return;
      const picture = image.closest('picture');
      if (retries === 0 && /\.webp(?:\?|$)/i.test(image.currentSrc)) {
        retries = 1;
        picture?.querySelectorAll('source').forEach((source) => source.remove());
        // Removing source makes the browser select the JPEG img/srcset.
      } else {
        retries = 2;
        picture?.querySelectorAll('source').forEach((source) => source.remove());
        image.removeAttribute('srcset');
        image.removeAttribute('sizes');
        if (image.dataset.originalSrc) image.src = image.dataset.originalSrc;
      }
    };
    image.addEventListener('error', recover);
    if (image.complete && image.naturalWidth === 0) recover();
  });
</script>
